NEXT_PUBLIC_DEFAULT_NETWORK="mainnet"
NEXT_PUBLIC_FEE_ADDRESS=
NEXT_PUBLIC_GRAPHQL_API_URL=https://api.memez.interestlabs.io/v2/graphql

# Sui GraphQL endpoint (optional, defaults to the Sui-maintained endpoint for the selected network)
NEXT_PUBLIC_SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# Sui gRPC endpoint (optional, defaults to the Sui-maintained public fullnode for the selected network)
NEXT_PUBLIC_SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443

DATABASE_URL=
SUI_PRIVATE_KEY=

# NextAuth will automatically use http://localhost:3000/api/auth/callback/twitter
# For production, set NEXTAUTH_URL to your production URL
AUTH_SECRET=

# Twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Redis
REDIS_URL=

# Nexa API
NEXA_API_KEY=

# BlockVision API (for market data fallback)
BLOCKVISION_API_KEY=
